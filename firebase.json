{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "backend",
      "codebase": "default",
      "runtime": "nodejs24",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "*.local",
        ".env.*",
        "serviceAccountKey*.json",
        "testes"
      ]
    }
  ],
  "hosting": {
    "public": "frontend-react/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["npm --prefix frontend-react run build"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": { "functionId": "api", "region": "southamerica-east1" }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "singleProjectMode": true,
    "ui": { "enabled": true, "port": 4000 },
    "hosting": { "port": 5000 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 }
  }
}
