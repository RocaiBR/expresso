# Configuração do servidor local (npm run dev e npm run importar:csv).
# Copie este arquivo para ".env.servidor" e deixe ativa UMA das opções abaixo.
#
# Não use o nome ".env": o Firebase CLI lê esse arquivo e envia as variáveis para a
# Cloud Function no deploy (e PORT é proibida lá). O ".env.servidor" fica só na sua máquina.

PORT=3000

# Opção A — banco local no emulador (rode "npm run emuladores" em outro terminal)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
PROJETO_FIREBASE=demo-expresso
BUCKET_FIREBASE=demo-expresso.appspot.com

# Opção B — Firestore de verdade, na nuvem (comente as linhas da opção A)
# Baixe a chave em: Console do Firebase > Configurações do projeto > Contas de serviço
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# PROJETO_FIREBASE=pi-expresso
# BUCKET_FIREBASE=pi-expresso.firebasestorage.app
