{
  "name": "pi-api",
  "version": "1.0.0",
  "description": "API do Projeto Integrador - controle de fluxo e atividades (Node.js + Express + Firebase)",
  "main": "index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "emuladores": "firebase emulators:start --project demo-expresso --import=../.emulador-dados --export-on-exit",
    "importar:csv": "node scripts/importarCsv.js",
    "testar": "node testes/testar_gravacao.js",
    "logs": "firebase functions:log --only api"
  },
  "keywords": [
    "api",
    "express",
    "firebase",
    "firestore",
    "projeto-integrador"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
